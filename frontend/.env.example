# Base URL of the Memora API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Value sent in the APP_SECURITY_KEY request header.
# This is the same value as APP_API_KEY in the backend's app.env.
#
# Anything shipped to a browser is readable by the user, so treat this as a
# local/demo convenience rather than a secret. Do not deploy a real key here.
VITE_APP_SECURITY_KEY=
