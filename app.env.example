# Copy to app.env and fill in real values. app.env is git-ignored.

# --- Required -------------------------------------------------------------
# Async SQLAlchemy URL. A bare postgresql:// is upgraded to +asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/memora

# Protects the chat model and tools.
OPENROUTER_API_KEY=sk-or-...

# Shared secret sent in the APP_SECURITY_KEY header.
APP_API_KEY=change-me

# --- Models ---------------------------------------------------------------
# OpenRouter is the only provider: it serves both the chat completions and the
# embeddings endpoint, so OPENROUTER_API_KEY above covers everything.
# Model IDs are hardcoded where they are used:
#   chat       -> agent/orchestrator.py  ("stealth/space-bunny-alpha")
#   embeddings -> services/embedding.py  ("nvidia/llama-nemotron-embed-vl-1b-v2:free")
# Catalog: https://openrouter.ai/api/v1/embeddings/models
#
# EMBEDDING_DIMENSIONS must match the vector(N) width in
# backend/app/db/schema.sql. The service verifies the returned width at
# runtime, so a mismatch fails loudly on the first upload.
EMBEDDING_DIMENSIONS=1536

# --- Optional -------------------------------------------------------------
# TAVILY_API_KEY=tvly-... (Required for Web Search tool. Recomended to add!)
# DB_ECHO=false
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_BYTES=26214400
# EXTRACT_IMAGES=false
