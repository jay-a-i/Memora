# Copy to app.env and fill in real values. app.env is git-ignored.

# --- DATABASE -------------------------------------------------------------
# Async SQLAlchemy URL. A bare postgresql:// is upgraded to +asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/memora

# --- SECRETS -------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...
COHERE_API_KEY=...
APP_API_KEY=change-me
# TAVILY_API_KEY=tvly-...

# --- Optional -------------------------------------------------------------
# DB_ECHO=false
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_BYTES=26214400
# EXTRACT_IMAGES=false
LLM="" # Must be a listed model in openrouter site
EMBEDDING_MODEL="" # Must be a listed embeddings model in cohere site