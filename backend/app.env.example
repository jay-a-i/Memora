
#----------------------------------------------------------------------------

PROJECT_NAME = MEMORA
BACKEND_VERSION = 1.0
CORS_ORIGINS = ["domain"] 

# --- DATABASE -------------------------------------------------------------
DATABASE_URL = change_me...
DB_ECHO= True
DB_POOL_SIZE = 20
DB_MAX_OVERFLOW = 10

# --- SECRETS --------------------------------------------------------------
OPENROUTER_API_KEY = change_me...
COHERE_API_KEY = change_me...
TAVILY_API_KEY = change_me...
APP_API_KEY = change_me...

# --- MODELS ---------------------------------------------------------------
LLM = change_me... # OPENROUTER LISTED MODEL
EMBEDDING_MODEL = change_me... #COHERE LISTED EMBEDDING MODEL

# --- EMBEDDING -------------------------------------------------------------
EMBEDDING_DIMENSIONS = 1536
EMBEDDING_BATCH_SIZE = 32

# --- Ingestion -------------------------------------------------------------
UPLOAD_DIR = temp_uploads
MAX_UPLOAD_BYTES = 26214400
ALLOWED_EXTENSIONS = [".pdf", ".txt", ".md", ".docx"]
CHUNK_SIZE = 1000
CHUNK_OVERLAP = 200
INGEST_BATCH_SIZE = 500
EXTRACT_IMAGES = False

# --- Agent ------------------------------------------------------------------
MAX_TOOL_CALLS = 20
MAX_LLM_CALLS = 12
MAX_HISTORY_MESSAGES = 20

#--- Tools -------------------------------------------------------------------
TOOL_CHOICE = auto
PARALLEL_TOOL_CALL = True

# --- LangGraph checkpointer -------------------------------------------------
CHECKPOINTER_POOL_SIZE = 5
CHECKPOINTER_TIMEOUT = 30



#pydantic is not able to parse CORS_ORIGINS and ALLOWED_EXTENSIONS when defined as just strings: "", "", "" or x, y, z