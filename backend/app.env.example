# Copy to app.env and fill in real values. app.env is git-ignored.

# --- DATABASE -------------------------------------------------------------
# Async SQLAlchemy URL. A bare postgresql:// is upgraded to +asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/memora

# --- SECRETS -------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...
COHERE_API_KEY=...
APP_API_KEY=change-me
# TAVILY_API_KEY=tvly-...

# --- Optional -------------------------------------------------------------
# All of these are commented out on purpose: an uncommented assignment
# OVERRIDES the built-in default, so writing DB_ECHO=false is redundant but
# writing LLM="" would set an empty model id, which the app rejects at startup.
#
# DB_ECHO=false
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_BYTES=26214400
# EXTRACT_IMAGES=false
# EMBEDDING_DIMENSIONS=1536

# --- Models ----------------------------------------------------------------
# Uncomment only to override the defaults in backend/app/core/config.py.
# Must name a real model id; a blank value fails validation at startup with a
# message telling you to delete the line instead.
# LLM=nvidia/nemotron-3-ultra-550b-a55b:free
# EMBEDDING_MODEL=embed-v5.0-pro

# --- LangGraph state persistence -------------------------------------------
# Persists the agent's own state (messages, tool calls, results) to Postgres,
# keyed by chat session id, so it resumes each conversation where it left off.
# The checkpoint_* tables are created automatically on first startup.
# CHECKPOINT_ENABLED=true
# CHECKPOINT_POOL_SIZE=5